# ─────────────────────────────────────────────────────────────────────────────
# ai-pr-review — environment variable template
#
# Copy this file to .env.local and fill in your values.
# NEVER commit the real .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Required: Groq API key for LLM inference.
# Obtain a free key at https://console.groq.com
GROQ_API_KEY=

# Optional: override the Groq model used for security analysis.
# Defaults to openai/gpt-oss-20b when not set.
# GROQ_SECURITY_MODEL=openai/gpt-oss-20b

# Optional: corporate proxy (e.g. Zscaler).
# Standard HTTPS_PROXY / HTTP_PROXY variables are honoured.
# TLS certificate verification is always kept enabled.
# If your corporate CA is not trusted by Node.js, add it via:
#   NODE_EXTRA_CA_CERTS=/path/to/corporate-ca.crt
# HTTPS_PROXY=http://proxy.example.com:8080
# NODE_EXTRA_CA_CERTS=

# Set automatically by the reusable GitHub Actions workflow.
# Set manually when running the CLI against a local repository checkout.
# REVIEW_REPO_ROOT=/path/to/the/repository/being/reviewed
