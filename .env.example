# ─────────────────────────────────────────────────────────────────────────────
# ai-pr-review — environment variable template
#
# Copy this file to .env.local and fill in your values.
# NEVER commit the real .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Required: Groq API key for LLM inference.
# Obtain a free key at https://console.groq.com
GROQ_API_KEY=

# Optional: override the Groq model used for security analysis.
# Defaults to openai/gpt-oss-20b when not set.
# GROQ_SECURITY_MODEL=openai/gpt-oss-20b

# Optional: override the Groq model used for code-quality analysis.
# Falls back to GROQ_SECURITY_MODEL, then to openai/gpt-oss-20b.
# GROQ_QUALITY_MODEL=openai/gpt-oss-20b

# Optional: Groq rate-limit retry tuning. The engine runs three agents per
# review; on a free tier those concurrent calls can trip a 429 rate limit.
# Each Groq call is retried with exponential backoff (honouring Retry-After)
# before giving up, so a brief rate limit does not drop findings.
#   AI_REVIEW_GROQ_MAX_RETRIES   extra attempts after the first (default 3)
#   AI_REVIEW_GROQ_RETRY_BASE_MS base backoff in ms (default 1000)
#   AI_REVIEW_GROQ_RETRY_CAP_MS  max single backoff in ms (default 15000)
# If you still hit rate limits often, raise the retries/backoff, or run fewer
# agents (see AI_REVIEW_ENABLE_* toggles below).
# AI_REVIEW_GROQ_MAX_RETRIES=3
# AI_REVIEW_GROQ_RETRY_BASE_MS=1000
# AI_REVIEW_GROQ_RETRY_CAP_MS=15000

# ─────────────────────────────────────────────────────────────────────────────
# Code-quality agent configuration
# ─────────────────────────────────────────────────────────────────────────────

# Master switch for the code-quality agent. Enabled by default.
# Set to false/0/no/off to run security analysis only.
# AI_REVIEW_ENABLE_QUALITY=true

# Run ONLY these categories (comma-separated allow-list). When set, it overrides
# the default-on set. Valid keys:
#   correctness, dead_code, duplication, error_handling,
#   maintainability, performance, api_contract, style, test_coverage
# Example — high-signal correctness/perf only:
# AI_REVIEW_QUALITY_CATEGORIES=correctness,error_handling,performance

# Disable specific categories from the default set (comma-separated).
# Example — turn off the noisier maintainability sub-checks:
# AI_REVIEW_DISABLE_CATEGORIES=maintainability

# Drop findings below this severity. One of LOW|MEDIUM|HIGH|CRITICAL (default LOW).
# Example — only surface MEDIUM and above:
# AI_REVIEW_QUALITY_MIN_SEVERITY=MEDIUM
#
# Default-ON categories:  correctness, dead_code, duplication, error_handling,
#                         maintainability, performance, api_contract
# Default-OFF categories: style, test_coverage  (subjective / need whole-PR context)

# ─────────────────────────────────────────────────────────────────────────────
# Security agent configuration
# ─────────────────────────────────────────────────────────────────────────────

# Master switch for the security agent. Enabled by default.
# Set to false/0/no/off to run quality analysis only.
# AI_REVIEW_ENABLE_SECURITY=true

# Run ONLY these security categories (comma-separated allow-list). Valid keys:
#   injection, web, secrets, crypto, files, data_exposure, config, auth, api
# Example — injection + crypto only:
# AI_REVIEW_SECURITY_CATEGORIES=injection,crypto

# Disable specific security categories from the default set (comma-separated).
# Example — turn off the config-header checks:
# AI_REVIEW_DISABLE_SECURITY_CATEGORIES=config

# Drop security findings below this severity. LOW|MEDIUM|HIGH|CRITICAL (default LOW).
# AI_REVIEW_SECURITY_MIN_SEVERITY=LOW
#
# Default-ON categories:  injection, web, secrets, crypto, files, data_exposure, config
# Default-OFF categories: auth, api  (context-heavy → higher false-positive risk; opt-in)
#
# NOTE: dependency/CVE scanning is intentionally NOT performed by the LLM —
# use a dedicated scanner (npm audit / OSV / Dependabot) for that.

# ─────────────────────────────────────────────────────────────────────────────
# Testing agent configuration
# ─────────────────────────────────────────────────────────────────────────────

# Master switch for the testing agent. Enabled by default.
# Set to false/0/no/off to skip test-quality analysis.
# AI_REVIEW_ENABLE_TESTING=true

# Run ONLY these testing categories (comma-separated allow-list). Valid keys:
#   coverage, assertions, flakiness, hygiene, mocking, async, isolation, smells
# Example — assertions + async only:
# AI_REVIEW_TESTING_CATEGORIES=assertions,async

# Disable specific testing categories from the default set (comma-separated).
# Example — turn off the inference-based coverage checks:
# AI_REVIEW_DISABLE_TESTING_CATEGORIES=coverage

# Drop testing findings below this severity. LOW|MEDIUM|HIGH|CRITICAL (default LOW).
# AI_REVIEW_TESTING_MIN_SEVERITY=LOW
#
# Optional: override the Groq model used for testing analysis.
# Falls back to GROQ_SECURITY_MODEL, then to the default model.
# GROQ_TESTING_MODEL=openai/gpt-oss-20b
#
# Default-ON categories:  coverage, assertions, flakiness, hygiene, mocking, async
# Default-OFF categories: isolation, smells  (noisier / subjective; opt-in)
#
# NOTE: the engine does NOT run the test suite or read coverage reports.
# Coverage findings are inferences from the diff, not a measured coverage delta.

# Optional: corporate proxy (e.g. Zscaler).
# Standard HTTPS_PROXY / HTTP_PROXY variables are honoured.
# TLS certificate verification is always kept enabled.
# If your corporate CA is not trusted by Node.js, add it via:
#   NODE_EXTRA_CA_CERTS=/path/to/corporate-ca.crt
# HTTPS_PROXY=http://proxy.example.com:8080
# NODE_EXTRA_CA_CERTS=

# Set automatically by the reusable GitHub Actions workflow.
# Set manually when running the CLI against a local repository checkout.
# REVIEW_REPO_ROOT=/path/to/the/repository/being/reviewed
